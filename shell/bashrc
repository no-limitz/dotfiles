# Sourced from ~/.bashrc by install.sh. Same environment as zsh, for workspaces
# where bash is the login shell and cannot be changed.
case $- in *i*) ;; *) return 0 2>/dev/null || exit 0 ;; esac

_dotfiles_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$_dotfiles_dir/common.sh"

# --- history ------------------------------------------------------------------
HISTSIZE=100000
HISTFILESIZE=100000
HISTCONTROL=ignoreboth:erasedups   # no dupes, and leading-space commands are not saved
shopt -s histappend checkwinsize cdspell autocd 2>/dev/null
# Write each command immediately so parallel terminals share history.
case ";${PROMPT_COMMAND:-};" in
  *";history -a;"*) ;;
  *) PROMPT_COMMAND="history -a${PROMPT_COMMAND:+;$PROMPT_COMMAND}" ;;
esac

# Up/Down search history for the text already typed.
bind '"\e[A": history-search-backward' 2>/dev/null
bind '"\e[B": history-search-forward' 2>/dev/null
bind 'set completion-ignore-case on' 2>/dev/null
bind 'set show-all-if-ambiguous on' 2>/dev/null

# --- prompt -------------------------------------------------------------------
# STARSHIP_SHELL is exported, so a bash started inside a starship zsh inherits it;
# check for this shell's own prompt hook instead.
if command -v starship >/dev/null 2>&1 && ! type starship_precmd >/dev/null 2>&1; then
  eval "$(starship init bash)"
fi

unset _dotfiles_dir
