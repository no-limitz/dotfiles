#!/usr/bin/env bash
# multica-register: make this machine a Multica agent runtime, so Multica can run
# agents (omp, claude, codex, ...) here.
#
#   multica-register               connect to multica.nolimitz.io and start the daemon
#   multica-register --status      show login, daemon and runtime state
#   multica-register --disable     stop the daemon and stop it autostarting
#
# Options:
#   --name NAME      runtime/device name shown in Multica (default: <owner>-<workspace>
#                    in a Coder workspace, else the hostname)
#   --repo [TARGET]  also add a git repo to the workspace's repository registry:
#                    TARGET is a path or URL, default the repo you are in or, outside
#                    one, every repo ghrepo cloned under $GHREPO_DIR (~/projects)
#   --ssh            with --repo: register the git@host:owner/name.git form of an https origin
#   --agent [NAME]   also create an agent on this machine's omp runtime, so issues can
#                    be assigned to it (default name: omp-<runtime name>)
#   --model ID       with --agent: the agent's model (default litellm/nolimitz/coder,
#                    or $MULTICA_AGENT_MODEL)
#   --profile NAME   use a separate multica profile (isolated config and login)
#
# Install and connect are the official steps: the install.sh installer, then
# `multica setup self-host --server-url URL --app-url URL` (browser sign-in, starts the
# daemon). Headless (SSH or Coder) uses MULTICA_NODE_TOKEN, or a pasted personal access
# token. Skipped if already signed in.
# The daemon finds agents on PATH when it starts, so install them first (omp needs
# multica >= 0.4.22, which this script enforces).
set -uo pipefail

SERVER="${MULTICA_SERVER_URL:-https://multica.nolimitz.io}"
MARKER="$HOME/.multica-enabled"
MIN_VERSION="0.4.22"   # first release with the omp runtime
ACTION=register NAME="" PROFILE="" REPO=0 REPO_TARGET="" SSH_FORM=0
AGENT=0 AGENT_NAME="" MODEL="${MULTICA_AGENT_MODEL:-litellm/nolimitz/coder}"

die() { printf 'multica-register: %s\n' "$*" >&2; exit 1; }
say() { printf '%s\n' "$*"; }

while [ $# -gt 0 ]; do
  case "$1" in
    --status)  ACTION=status ;;
    --disable) ACTION=disable ;;
    --name)    shift; [ $# -gt 0 ] || die "--name needs a value"; NAME="$1" ;;
    --profile) shift; [ $# -gt 0 ] || die "--profile needs a name"; PROFILE="$1" ;;
    --ssh)     SSH_FORM=1 ;;
    --repo)    REPO=1
               if [ $# -gt 1 ] && [ "${2#-}" = "$2" ]; then shift; REPO_TARGET="$1"; fi ;;
    --agent)   AGENT=1
               if [ $# -gt 1 ] && [ "${2#-}" = "$2" ]; then shift; AGENT_NAME="$1"; fi ;;
    --model)   shift; [ $# -gt 0 ] || die "--model needs a value"; MODEL="$1" ;;
    -h|--help) sed -n '2,27p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)         die "unknown argument: $1" ;;
  esac
  shift
done
command -v jq >/dev/null 2>&1 || die "jq is required"

# status and disable only inspect or stop things: never install the CLI for them.
if [ "$ACTION" != register ] && ! command -v multica >/dev/null 2>&1; then
  if [ "$ACTION" = status ]; then
    say "multica CLI is not installed. Run multica-register to install and connect."
  else
    rm -f "$MARKER"; say "multica CLI is not installed; nothing to disable."
  fi
  exit 0
fi

# --- CLI ----------------------------------------------------------------------
# version_ge A B: A >= B for dotted versions.
version_ge() { [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n 1)" = "$2" ]; }
cli_version() { multica version 2>/dev/null | awk 'NR == 1 { print $2 }'; }

if ! command -v multica >/dev/null 2>&1; then
  say "multica CLI not found; installing."
  # Official installer (uses Homebrew when present, else a release binary).
  # The binary goes in ~/.local/bin, not the installer's default /usr/local/bin:
  # on a Coder workspace only the home volume survives a restart, and a CLI lost
  # there leaves ~/.multica-enabled pointing the autostart at nothing.
  mkdir -p "$HOME/.local/bin"
  curl -fsSL https://raw.githubusercontent.com/multica-ai/multica/main/scripts/install.sh \
    | MULTICA_BIN_DIR="$HOME/.local/bin" bash \
    || die "install failed"
  export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
  command -v multica >/dev/null 2>&1 || die "multica is still not on PATH; open a new shell and re-run"
fi

MC=(multica)
[ -n "$PROFILE" ] && MC+=(--profile "$PROFILE")

# --- naming -------------------------------------------------------------------
# In Coder: name the runtime <owner>-<workspace> and pin the daemon id to the
# workspace id, so a rebuild updates the same runtime instead of leaving a dead one.
if [ -n "${CODER_WORKSPACE_NAME:-}" ]; then
  default_name="$(printf '%s-%s' "${CODER_WORKSPACE_OWNER_NAME:-coder}" "$CODER_WORKSPACE_NAME" | tr '[:upper:]' '[:lower:]')"
  [ -n "${MULTICA_DAEMON_ID:-}" ] || { [ -z "${CODER_WORKSPACE_ID:-}" ] || export MULTICA_DAEMON_ID="$CODER_WORKSPACE_ID"; }
else
  default_name="$(hostname)"
fi
RUNTIME_NAME="${NAME:-${MULTICA_AGENT_RUNTIME_NAME:-$default_name}}"
export MULTICA_AGENT_RUNTIME_NAME="$RUNTIME_NAME" MULTICA_DAEMON_DEVICE_NAME="$RUNTIME_NAME"

# Agent CLIs the daemon must not register as runtimes (it registers every one it finds on
# PATH). Default: copilot, so Multica only runs agents on the LiteLLM gateway models.
# MULTICA_DISABLE_AGENTS="" turns this off; a space-separated list replaces it. Each name
# NAME is hidden by pointing MULTICA_NAME_PATH at a path that does not exist.
DISABLE_AGENTS="${MULTICA_DISABLE_AGENTS-copilot}"
for _a in $DISABLE_AGENTS; do
  export "MULTICA_$(printf '%s' "$_a" | tr '[:lower:]' '[:upper:]')_PATH=/nonexistent/$_a"
done

# --- helpers ------------------------------------------------------------------
# config_value KEY: value from `multica config show`; empty if unset (shown as "(not set)").
config_value() {
  "${MC[@]}" config show 2>/dev/null \
    | awk -v k="$1:" '$1 == k { $1 = ""; sub(/^ +/, ""); if ($0 !~ /^\(not set\)/) print }'
}

# `multica auth status` exits 0 even when signed out ("Not authenticated") and
# prints to stderr as well as stdout, so capture both and look for a "User:" line.
signed_in() {
  local out
  out="$("${MC[@]}" auth status 2>&1)"
  case "$out" in *$'\n'User:*|User:*) return 0 ;; *) return 1 ;; esac
}

# `multica daemon status` first line is "Daemon: stopped" or "Daemon:      running (...)";
# the padding differs between CLI versions, so split on whitespace.
daemon_running() {
  local out
  out="$("${MC[@]}" daemon status 2>&1)"
  printf '%s\n' "$out" | awk 'NR == 1 { r = ($1 == "Daemon:" && $2 == "running") } END { exit !r }'
}

# runtimes_here: runtime rows (provider, status, name) whose name contains this
# machine's runtime name.
runtimes_here() {
  "${MC[@]}" runtime list --output json 2>/dev/null \
    | jq -r --arg n "$RUNTIME_NAME" '.[] | select(.name | contains($n)) | [.provider, .status, .name] | @tsv'
}

show_runtimes() {
  local rows
  rows="$(runtimes_here)"
  if [ -z "$rows" ]; then say "  (no runtime named *$RUNTIME_NAME* registered yet)"; return 1; fi
  printf '%s\n' "$rows" | awk -F'\t' '{ printf "  %-10s %-8s %s\n", $1, $2, $3 }'
}

# --- status / disable ---------------------------------------------------------
if [ "$ACTION" = status ]; then
  server="$(config_value server_url)"
  say "Server:  ${server:-(not set)}"
  signed_in && "${MC[@]}" auth status 2>&1 | sed -n '2p' | sed 's/^/  /' || say "  not signed in"
  say "Daemon:  $("${MC[@]}" daemon status 2>&1 | head -n 1 | sed -E 's/^Daemon:[[:space:]]*//')"
  say "Autostart marker: $([ -f "$MARKER" ] && echo present || echo absent)"
  say "Runtimes named *$RUNTIME_NAME*:"
  show_runtimes
  exit 0
fi

if [ "$ACTION" = disable ]; then
  "${MC[@]}" daemon stop >/dev/null 2>&1 && say "Daemon stopped." || say "Daemon was not running."
  rm -f "$MARKER" && say "Autostart removed. The runtime stays listed (offline) in Multica until you delete it there."
  exit 0
fi

# --- agents -------------------------------------------------------------------
# The daemon registers one runtime per agent CLI it finds on PATH at start, and
# `multica setup self-host` below starts it, so check this before connecting.
found=""
for c in omp claude codex opencode copilot pi; do
  case " $DISABLE_AGENTS " in *" $c "*) continue ;; esac
  command -v "$c" >/dev/null 2>&1 && found="$found $c"
done
[ -n "$found" ] || die "no usable agent CLI on PATH (looked for omp claude codex opencode copilot pi, minus disabled: ${DISABLE_AGENTS:-none}); install one first"
say "Agents on PATH:$found"
case " $found " in
  *" omp "*)
    ver="$(cli_version)"
    if [ -n "$ver" ] && ! version_ge "$ver" "$MIN_VERSION"; then
      say "multica $ver predates the omp runtime (needs $MIN_VERSION); updating."
      "${MC[@]}" update || die "update failed; upgrade multica and re-run"
      ver="$(cli_version)"
      version_ge "${ver:-0}" "$MIN_VERSION" || die "multica is still $ver; upgrade it and re-run"
    fi ;;
esac

# --- connect ------------------------------------------------------------------
headless=0
if [ -n "${SSH_CONNECTION:-}${CODER_WORKSPACE_NAME:-}" ]; then
  headless=1
elif [ "$(uname -s)" != "Darwin" ] && [ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
  headless=1
fi

if signed_in && [ "$(config_value server_url)" = "$SERVER" ]; then
  say "Already signed in to $SERVER."
elif [ -z "${MULTICA_NODE_TOKEN:-}" ] && [ "$headless" = 0 ]; then
  # Desktop: the standard flow. Opens a browser to sign in, then starts the daemon.
  say "Connecting to $SERVER (a browser will open to sign in)."
  "${MC[@]}" setup self-host --server-url "$SERVER" --app-url "$SERVER" || die "setup self-host failed"
else
  # No browser: set the server by hand and sign in with a token.
  "${MC[@]}" config set server_url "$SERVER" >/dev/null || die "could not set server_url"
  "${MC[@]}" config set app_url "$SERVER" >/dev/null || die "could not set app_url"
  if [ -n "${MULTICA_NODE_TOKEN:-}" ]; then
    "${MC[@]}" login --token "$MULTICA_NODE_TOKEN" || die "login with MULTICA_NODE_TOKEN failed"
  else
    say "No browser here. Create a personal access token in the web app ($SERVER),"
    say "then paste it below."
    "${MC[@]}" login --token || die "login failed"
  fi
fi
signed_in || die "still not signed in"
"${MC[@]}" auth status 2>&1 | sed -n '2p' | sed 's/^/  /'

# --- daemon -------------------------------------------------------------------
if daemon_running; then
  say "Daemon already running."
else
  say "Starting the daemon as '$RUNTIME_NAME'."
  # The daemon keeps whatever stdout it was started with open. Send it to a file,
  # not a pipe, so a caller that captures this script's output (ssh, CI, $(...))
  # still sees it exit.
  start_log="$(mktemp)"
  if "${MC[@]}" daemon start </dev/null >"$start_log" 2>&1; then
    cat "$start_log"; rm -f "$start_log"
  else
    cat "$start_log"; rm -f "$start_log"
    die "daemon did not start (see: multica daemon logs)"
  fi
fi
touch "$MARKER"

# Registration happens just after start; wait for the runtime to show up online.
online=0
for _ in $(seq 1 20); do
  if runtimes_here | awk -F'\t' '$2 == "online" { f = 1 } END { exit !f }'; then online=1; break; fi
  sleep 2
done
say "Runtimes:"
show_runtimes
[ "$online" = 1 ] || say "warning: no online runtime yet; check 'multica daemon logs'"

# --- optional: agent ----------------------------------------------------------
# An agent is what issues get assigned to. Bind one to this machine's omp runtime,
# with the default model, creating it or fixing its model if it already exists.
if [ "$AGENT" = 1 ]; then
  rid="$("${MC[@]}" runtime list --output json 2>/dev/null \
    | jq -r --arg n "$RUNTIME_NAME" '[.[] | select(.provider == "omp" and (.name | contains($n)))][0].id // empty')"
  [ -n "$rid" ] || die "no omp runtime named *$RUNTIME_NAME* to attach an agent to"
  aname="${AGENT_NAME:-omp-$RUNTIME_NAME}"
  aid="$("${MC[@]}" agent list --output json 2>/dev/null \
    | jq -r --arg n "$aname" '[.[] | select(.name == $n and .archived_at == null)][0].id // empty')"
  if [ -n "$aid" ]; then
    "${MC[@]}" agent update "$aid" --model "$MODEL" --output json >/dev/null \
      || die "could not set model on agent $aname"
    say "Agent '$aname' exists; model set to $MODEL."
  else
    "${MC[@]}" agent create --name "$aname" --runtime-id "$rid" --model "$MODEL" \
      --visibility workspace --description "omp on $RUNTIME_NAME" --output json >/dev/null \
      || die "agent create failed"
    say "Agent '$aname' created on $RUNTIME_NAME with model $MODEL."
  fi
fi

# --- optional: repository registry --------------------------------------------
if [ "$REPO" = 1 ]; then
  # URL -> one repo. Path -> that repo. Neither: the repo you are in, or, when you
  # are not in one, every repo ghrepo cloned under $GHREPO_DIR (default ~/projects).
  repo_urls=()
  origin_of() {
    git -C "$1" rev-parse --show-toplevel >/dev/null 2>&1 || return 1
    git -C "$1" remote get-url origin 2>/dev/null
  }
  case "$REPO_TARGET" in
    *://*|*@*:*) repo_urls+=("$REPO_TARGET") ;;
    "")
      if u="$(origin_of .)"; then
        repo_urls+=("$u")
      else
        root="${GHREPO_DIR:-$HOME/projects}"
        for d in "$root"/*/; do
          [ -e "${d}.git" ] || continue
          u="$(origin_of "$d")" && repo_urls+=("$u")
        done
        [ ${#repo_urls[@]} -gt 0 ] || die "not in a git repository and no clones under $root; run ghrepo first"
        say "Not in a repo; using the ${#repo_urls[@]} repo(s) cloned under $root."
      fi ;;
    *)
      [ -d "$REPO_TARGET" ] || die "not a directory: $REPO_TARGET"
      u="$(origin_of "$REPO_TARGET")" || die "$REPO_TARGET is not a git repository with an 'origin' remote"
      repo_urls+=("$u") ;;
  esac

  # norm URL: host/owner/name, so ssh and https forms of one repo compare equal.
  norm() {
    printf '%s' "$1" | sed -E '
      s#^[a-z+]+://##; s#^[^@/]+@##; s#:([^0-9])#/\1#; s#^([^/]+):[0-9]+/#\1/#; s#\.git/?$##; s#/$##' \
      | tr '[:upper:]' '[:lower:]'
  }
  existing="$("${MC[@]}" repo list --output json 2>/dev/null | jq -r '.[].url')"
  failed=0
  for url in "${repo_urls[@]}"; do
    # https://host/o/n(.git) -> git@host:o/n.git
    if [ "$SSH_FORM" = 1 ]; then
      case "$url" in
        https://*|http://*) url="$(printf '%s' "${url#*://}" | sed -E 's#^([^/]+)/(.*)$#git@\1:\2#; s#(\.git)?$#.git#')" ;;
      esac
    fi
    want="$(norm "$url")"
    have_it=""
    while IFS= read -r have; do
      [ -n "$have" ] && [ "$(norm "$have")" = "$want" ] && { have_it="$have"; break; }
    done <<< "$existing"
    if [ -n "$have_it" ]; then
      say "Repo already registered: $have_it"
    else
      say "Registering repo $url"
      "${MC[@]}" repo add "$url" --output table || { say "repo add failed: $url"; failed=1; }
    fi
  done
  [ "$failed" = 0 ] || exit 1
fi
