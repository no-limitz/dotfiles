#!/usr/bin/env bash
# multica-register: make this machine a Multica agent runtime, so Multica can run
# agents (omp, claude, codex, ...) here.
#
#   multica-register               connect to multica.nolimitz.io and start the daemon
#   multica-register --status      show login, daemon and runtime state
#   multica-register --disable     stop the daemon and stop it autostarting
#
# Options:
#   --name NAME      runtime/device name shown in Multica (default: <owner>-<workspace>
#                    in a Coder workspace, else the hostname)
#   --repo [TARGET]  also add a git repo to the workspace's repository registry:
#                    TARGET is a path or URL, default the repo you are in
#   --ssh            with --repo: register the git@host:owner/name.git form of an https origin
#   --profile NAME   use a separate multica profile (isolated config and login)
#
# Sign-in, in order: MULTICA_NODE_TOKEN (no prompt); a pasted personal access token over
# SSH or in Coder; browser OAuth on a desktop. Skipped if already signed in.
# The daemon finds agents on PATH when it starts, so install them first (omp needs
# multica >= 0.4.22, which this script enforces).
set -uo pipefail

SERVER="${MULTICA_SERVER_URL:-https://multica.nolimitz.io}"
MARKER="$HOME/.multica-enabled"
MIN_VERSION="0.4.22"   # first release with the omp runtime
ACTION=register NAME="" PROFILE="" REPO=0 REPO_TARGET="" SSH_FORM=0

die() { printf 'multica-register: %s\n' "$*" >&2; exit 1; }
say() { printf '%s\n' "$*"; }

while [ $# -gt 0 ]; do
  case "$1" in
    --status)  ACTION=status ;;
    --disable) ACTION=disable ;;
    --name)    shift; [ $# -gt 0 ] || die "--name needs a value"; NAME="$1" ;;
    --profile) shift; [ $# -gt 0 ] || die "--profile needs a name"; PROFILE="$1" ;;
    --ssh)     SSH_FORM=1 ;;
    --repo)    REPO=1
               if [ $# -gt 1 ] && [ "${2#-}" = "$2" ]; then shift; REPO_TARGET="$1"; fi ;;
    -h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)         die "unknown argument: $1" ;;
  esac
  shift
done
command -v jq >/dev/null 2>&1 || die "jq is required"

# --- CLI ----------------------------------------------------------------------
# version_ge A B: A >= B for dotted versions.
version_ge() { [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n 1)" = "$2" ]; }
cli_version() { multica version 2>/dev/null | awk 'NR == 1 { print $2 }'; }

if ! command -v multica >/dev/null 2>&1; then
  say "multica CLI not found; installing."
  if command -v brew >/dev/null 2>&1; then
    brew install multica-ai/tap/multica || die "brew install failed"
  else
    mkdir -p "$HOME/.local/bin"
    MULTICA_BIN_DIR="$HOME/.local/bin" bash -c \
      "$(curl -fsSL https://raw.githubusercontent.com/multica-ai/multica/main/scripts/install.sh)" \
      || die "install failed"
    export PATH="$HOME/.local/bin:$PATH"
  fi
  command -v multica >/dev/null 2>&1 || die "multica is still not on PATH"
fi

MC=(multica)
[ -n "$PROFILE" ] && MC+=(--profile "$PROFILE")

# --- naming -------------------------------------------------------------------
# In Coder: name the runtime <owner>-<workspace> and pin the daemon id to the
# workspace id, so a rebuild updates the same runtime instead of leaving a dead one.
if [ -n "${CODER_WORKSPACE_NAME:-}" ]; then
  default_name="$(printf '%s-%s' "${CODER_WORKSPACE_OWNER_NAME:-coder}" "$CODER_WORKSPACE_NAME" | tr '[:upper:]' '[:lower:]')"
  [ -n "${MULTICA_DAEMON_ID:-}" ] || { [ -z "${CODER_WORKSPACE_ID:-}" ] || export MULTICA_DAEMON_ID="$CODER_WORKSPACE_ID"; }
else
  default_name="$(hostname)"
fi
RUNTIME_NAME="${NAME:-${MULTICA_AGENT_RUNTIME_NAME:-$default_name}}"
export MULTICA_AGENT_RUNTIME_NAME="$RUNTIME_NAME" MULTICA_DAEMON_DEVICE_NAME="$RUNTIME_NAME"

# --- helpers ------------------------------------------------------------------
# config_value KEY: value from `multica config show`, empty if unset.
config_value() { "${MC[@]}" config show 2>/dev/null | awk -v k="$1:" '$1 == k { print $2 }'; }

# `multica auth status` exits 0 even when signed out ("Not authenticated") and
# prints to stderr as well as stdout, so capture both and look for a "User:" line.
signed_in() {
  local out
  out="$("${MC[@]}" auth status 2>&1)"
  case "$out" in *$'\n'User:*|User:*) return 0 ;; *) return 1 ;; esac
}

# `multica daemon status` prints "Daemon: stopped" or "Daemon: running ...".
daemon_running() {
  local line
  line="$("${MC[@]}" daemon status 2>&1 | head -n 1)"
  [ "${line#Daemon: running}" != "$line" ]
}

# runtimes_here: runtime rows (provider, status, name) whose name contains this
# machine's runtime name.
runtimes_here() {
  "${MC[@]}" runtime list --output json 2>/dev/null \
    | jq -r --arg n "$RUNTIME_NAME" '.[] | select(.name | contains($n)) | [.provider, .status, .name] | @tsv'
}

show_runtimes() {
  local rows
  rows="$(runtimes_here)"
  if [ -z "$rows" ]; then say "  (no runtime named *$RUNTIME_NAME* registered yet)"; return 1; fi
  printf '%s\n' "$rows" | awk -F'\t' '{ printf "  %-10s %-8s %s\n", $1, $2, $3 }'
}

# --- status / disable ---------------------------------------------------------
if [ "$ACTION" = status ]; then
  say "Server:  $(config_value server_url)"
  signed_in && "${MC[@]}" auth status 2>&1 | sed -n '2p' | sed 's/^/  /' || say "  not signed in"
  say "Daemon:  $("${MC[@]}" daemon status 2>&1 | head -n 1 | sed 's/^Daemon: //')"
  say "Autostart marker: $([ -f "$MARKER" ] && echo present || echo absent)"
  say "Runtimes named *$RUNTIME_NAME*:"
  show_runtimes
  exit 0
fi

if [ "$ACTION" = disable ]; then
  "${MC[@]}" daemon stop >/dev/null 2>&1 && say "Daemon stopped." || say "Daemon was not running."
  rm -f "$MARKER" && say "Autostart removed. The runtime stays listed (offline) in Multica until you delete it there."
  exit 0
fi

# --- connect ------------------------------------------------------------------
[ "$(config_value server_url)" = "$SERVER" ] || "${MC[@]}" config set server_url "$SERVER" >/dev/null \
  || die "could not set server_url"
[ "$(config_value app_url)" = "$SERVER" ] || "${MC[@]}" config set app_url "$SERVER" >/dev/null \
  || die "could not set app_url"

if signed_in; then
  say "Already signed in to $SERVER."
else
  say "Signing in to $SERVER."
  headless=0
  if [ -n "${SSH_CONNECTION:-}${CODER_WORKSPACE_NAME:-}" ]; then
    headless=1
  elif [ "$(uname -s)" != "Darwin" ] && [ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
    headless=1
  fi
  if [ -n "${MULTICA_NODE_TOKEN:-}" ]; then
    "${MC[@]}" login --token "$MULTICA_NODE_TOKEN" || die "login with MULTICA_NODE_TOKEN failed"
  elif [ "$headless" = 1 ]; then
    say "No browser here. Create a personal access token in the web app ($SERVER),"
    say "then paste it below."
    "${MC[@]}" login --token || die "login failed"
  else
    "${MC[@]}" login || die "login failed"
  fi
  signed_in || die "still not signed in"
fi
"${MC[@]}" auth status 2>&1 | sed -n '2p' | sed 's/^/  /'

# --- agents -------------------------------------------------------------------
# The daemon registers one runtime per agent CLI it finds on PATH at start.
found=""
for c in omp claude codex opencode copilot pi; do
  command -v "$c" >/dev/null 2>&1 && found="$found $c"
done
[ -n "$found" ] || die "no agent CLI on PATH (looked for omp claude codex opencode copilot pi); install one first"
say "Agents on PATH:$found"
case " $found " in
  *" omp "*)
    ver="$(cli_version)"
    if [ -n "$ver" ] && ! version_ge "$ver" "$MIN_VERSION"; then
      say "multica $ver predates the omp runtime (needs $MIN_VERSION); updating."
      "${MC[@]}" update || die "update failed; upgrade multica and re-run"
      ver="$(cli_version)"
      version_ge "${ver:-0}" "$MIN_VERSION" || die "multica is still $ver; upgrade it and re-run"
    fi ;;
esac

# --- daemon -------------------------------------------------------------------
if daemon_running; then
  say "Daemon already running."
else
  say "Starting the daemon as '$RUNTIME_NAME'."
  "${MC[@]}" daemon start || die "daemon did not start (see: multica daemon logs)"
fi
touch "$MARKER"

# Registration happens just after start; wait for the runtime to show up online.
online=0
for _ in $(seq 1 20); do
  if runtimes_here | awk -F'\t' '$2 == "online" { f = 1 } END { exit !f }'; then online=1; break; fi
  sleep 2
done
say "Runtimes:"
show_runtimes
[ "$online" = 1 ] || say "warning: no online runtime yet; check 'multica daemon logs'"

# --- optional: repository registry --------------------------------------------
if [ "$REPO" = 1 ]; then
  url=""
  case "$REPO_TARGET" in
    *://*|*@*:*) url="$REPO_TARGET" ;;
    *)
      dir="${REPO_TARGET:-.}"
      [ -d "$dir" ] || die "not a directory: $dir"
      git -C "$dir" rev-parse --show-toplevel >/dev/null 2>&1 || die "$dir is not a git repository"
      url="$(git -C "$dir" remote get-url origin 2>/dev/null)" || die "$dir has no 'origin' remote"
      ;;
  esac
  # https://host/o/n(.git) -> git@host:o/n.git
  if [ "$SSH_FORM" = 1 ]; then
    case "$url" in
      https://*|http://*) url="$(printf '%s' "${url#*://}" | sed -E 's#^([^/]+)/(.*)$#git@\1:\2#; s#(\.git)?$#.git#')" ;;
    esac
  fi
  # norm URL: host/owner/name, so ssh and https forms of one repo compare equal.
  norm() {
    printf '%s' "$1" | sed -E '
      s#^[a-z+]+://##; s#^[^@/]+@##; s#:([^0-9])#/\1#; s#^([^/]+):[0-9]+/#\1/#; s#\.git/?$##; s#/$##' \
      | tr '[:upper:]' '[:lower:]'
  }
  want="$(norm "$url")"
  existing="$("${MC[@]}" repo list --output json 2>/dev/null | grep -o '"url": *"[^"]*"' | sed -E 's/"url": *"([^"]*)"/\1/')"
  while IFS= read -r have; do
    [ -n "$have" ] || continue
    if [ "$(norm "$have")" = "$want" ]; then
      say "Repo already registered: $have"
      exit 0
    fi
  done <<< "$existing"
  say "Registering repo $url"
  "${MC[@]}" repo add "$url" --output table || die "repo add failed"
fi
